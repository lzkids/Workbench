<ui:FluentWindow x:Class="Workbench.ConfirmWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="工作台" Width="400" Height="185"
        MinWidth="400" MaxWidth="480" MinHeight="185"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        ExtendsContentIntoTitleBar="True">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="工作台" Icon="/Assets/app.ico"/>

        <Grid Grid.Row="1" Margin="20,6,20,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 图标 + 消息 横排 -->
            <DockPanel Grid.Row="0" LastChildFill="True">
                <TextBlock x:Name="IconText" DockPanel.Dock="Left" FontSize="24"
                           Margin="0,0,12,0" VerticalAlignment="Top"/>
                <TextBlock x:Name="MessageText" TextWrapping="Wrap" FontSize="13.5"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
            </DockPanel>

            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right"
                        VerticalAlignment="Bottom">
                <ui:Button x:Name="OkButton" Content="确定" Appearance="Primary"
                           Padding="24,5" Margin="0,0,8,0" Click="Ok_Click" IsDefault="True"/>
                <ui:Button x:Name="CancelButton" Content="取消" Appearance="Secondary"
                           Padding="24,5" IsCancel="True"/>
            </StackPanel>
        </Grid>
    </Grid>
</ui:FluentWindow>
