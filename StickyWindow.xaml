<Window x:Class="Workbench.StickyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:views="clr-namespace:Workbench.Views"
        Title="便签" Width="280" Height="280" MinWidth="200" MinHeight="160"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="CanResizeWithGrip"
        Closed="Window_Closed">

    <Window.Resources>
        <views:NoteColorBrushConverter x:Key="NoteBrush"/>

        <!-- 便签窗工具按钮:浅底圆角,黄底上清晰可见 -->
        <Style x:Key="StickyToolButton" TargetType="Button">
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Background" Value="#FFFDF0"/>
            <Setter Property="Foreground" Value="#6B5E1E"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#F7E8A8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#E8D68A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid Margin="10">
        <Border CornerRadius="10" BorderThickness="1"
                Background="{Binding ColorKey, Converter={StaticResource NoteBrush}}"
                BorderBrush="{Binding ColorKey, Converter={StaticResource NoteBrush}, ConverterParameter=border}"
                MouseLeftButtonDown="Border_MouseLeftButtonDown">
            <Border.Effect>
                <DropShadowEffect BlurRadius="18" ShadowDepth="3" Direction="270"
                                  Opacity="0.28" Color="#6B5E1E"/>
            </Border.Effect>
        <DockPanel Margin="10">
            <DockPanel DockPanel.Dock="Top">
                <Button DockPanel.Dock="Right" Content="🎨" Style="{StaticResource StickyToolButton}"
                        ToolTip="更换颜色" Click="PickColor_Click"/>
                <Button DockPanel.Dock="Right" Content="✕" Style="{StaticResource StickyToolButton}"
                        ToolTip="关闭(空便签自动丢弃)" Click="Close_Click"/>
                <Button DockPanel.Dock="Right" Content="＋" Style="{StaticResource StickyToolButton}"
                        ToolTip="再开一张便签" Click="NewNote_Click"/>
                <TextBlock Text="便签" FontSize="12" VerticalAlignment="Center"
                           Foreground="{Binding ColorKey, Converter={StaticResource NoteBrush}, ConverterParameter=accent}"/>
            </DockPanel>
            <!-- md 编辑区:WebView2(Vditor 即时渲染,Typora 式)为主,初始化失败回退纯文本框。
                 WebView2 是 HWND 宿主(airspace):底部留 14px 让缩放 grip 可见,工具栏行与网页区上下排布不重叠 -->
            <Grid Margin="0,6,0,14">
                <!-- 编辑器从一开始就可见:WebView2 hwnd 必须以真实尺寸创建(Collapsed/Hidden 下 0 尺寸初始化会视口错配)。
                     FallbackBox 铺在同一格:初始化期间被 hwnd 盖住(airspace 恒在上),失败/看门狗时把 Editor 撤掉翻出来 -->
                <wv2:WebView2 x:Name="Editor"/>
                <TextBox x:Name="FallbackBox" Text="{Binding Content, UpdateSourceTrigger=PropertyChanged}"
                         AcceptsReturn="True" TextWrapping="Wrap"
                         Background="Transparent" BorderThickness="0"
                         FontSize="14"
                         Foreground="{Binding ColorKey, Converter={StaticResource NoteBrush}, ConverterParameter=fg}"
                         CaretBrush="{Binding ColorKey, Converter={StaticResource NoteBrush}, ConverterParameter=accent}"
                         VerticalScrollBarVisibility="Auto"/>
            </Grid>
        </DockPanel>
        </Border>
    </Grid>
</Window>
