<UserControl x:Class="Workbench.Views.TasksPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:models="clr-namespace:Workbench.Models"
             xmlns:local="clr-namespace:Workbench.Views">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <local:TagForeConverter x:Key="TagFore"/>
        <local:TagBgConverter x:Key="TagBg"/>
    </UserControl.Resources>

    <DockPanel>
        <!-- 新建行:过滤 + 标题 + 状态 + 添加 -->
        <Border DockPanel.Dock="Top" Padding="0,0,0,12">
            <DockPanel>
                <ui:Button DockPanel.Dock="Right" Command="{Binding AddCommand}"
                           Appearance="Primary" Content="添加" Padding="18,5" Margin="8,0,0,0"/>
                <ComboBox DockPanel.Dock="Right" Width="92" Margin="8,0,0,0"
                          ItemsSource="{Binding StatusOptions}"
                          SelectedItem="{Binding NewStatus}"
                          ToolTip="新任务的状态"/>
                <ComboBox DockPanel.Dock="Right" Width="92" Margin="8,0,0,0"
                          ItemsSource="{Binding FilterOptions}"
                          SelectedItem="{Binding FilterStatus}"
                          ToolTip="只看某个状态"/>
                <ComboBox DockPanel.Dock="Right" Width="92" Margin="8,0,0,0"
                          IsEditable="true" ToolTip="新任务的标签(可自定义)"
                          Text="{Binding NewTag, UpdateSourceTrigger=PropertyChanged}"
                          ItemsSource="{Binding TagOptions}"/>
                <ui:TextBox Text="{Binding NewTitle, UpdateSourceTrigger=PropertyChanged}"
                            PlaceholderText="输入任务标题,回车添加">
                    <ui:TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding AddCommand}"/>
                    </ui:TextBox.InputBindings>
                </ui:TextBox>
            </DockPanel>
        </Border>

        <Grid>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Items}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <ui:Card Padding="12,9" Margin="0,0,0,10">
                                <StackPanel>
                                    <DockPanel>
                                        <ui:Button DockPanel.Dock="Right" Content="✕" Width="28" Height="28"
                                                   Appearance="Secondary" Padding="2,0"
                                                   ToolTip="删除(进回收站)"
                                                   Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                   CommandParameter="{Binding}"/>
                                        <ui:Button DockPanel.Dock="Right" Content="📦" Width="28" Height="28"
                                                   Appearance="Secondary" Padding="2,0" ToolTip="归档(移到归档页)"
                                                   Command="{Binding DataContext.ArchiveCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                   CommandParameter="{Binding}"/>
                                        <ui:Button DockPanel.Dock="Right" Content="→" Width="28" Height="28"
                                                   Appearance="Secondary" Padding="2,0"
                                                   ToolTip="切换状态"
                                                   Command="{Binding DataContext.CycleStatusCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                   CommandParameter="{Binding}"/>
                                        <!-- 子任务折叠切换:纯图标,进度看悬停提示 -->
                                        <ui:Button DockPanel.Dock="Right" Content="{Binding SubTasksToggleText}"
                                                   Width="28" Height="28" Appearance="Secondary" Padding="2,0"
                                                   ToolTip="{Binding SubTasksToolTip}"
                                                   Click="SubTasksToggle_Click"/>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <!-- 状态胶囊:中性底 + 彩色文字,深浅主题通吃 -->
                                            <Border CornerRadius="10" Padding="9,2"
                                                    Background="{DynamicResource ControlFillColorDefaultBrush}"
                                                    BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                                                    BorderThickness="1">
                                                <TextBlock Text="{Binding Status}" FontSize="11">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground"
                                                                    Value="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Status}" Value="进行中">
                                                                    <Setter Property="Foreground" Value="#D97706"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Status}" Value="已完成">
                                                                    <Setter Property="Foreground" Value="#16A34A"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                            <!-- 标签徽章:Tag 为空时隐藏;颜色随标签语义(Error 红/Warning 黄/Done 绿/紧急 红) -->
                                            <Border CornerRadius="8" Padding="7,1" Margin="8,0,0,0"
                                                    VerticalAlignment="Center"
                                                    Background="{Binding Tag, Converter={StaticResource TagBg}}">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Tag}" Value="">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding Tag}" FontSize="10.5"
                                                           Foreground="{Binding Tag, Converter={StaticResource TagFore}}"/>
                                            </Border>
                                            <!-- 标题:点击打开编辑窗;完成后划线 -->
                                            <TextBlock Text="{Binding Title}" FontSize="14" Margin="10,0,0,0"
                                                       VerticalAlignment="Center" Cursor="Hand" ToolTip="点击编辑详情"
                                                       MouseLeftButtonDown="Title_Click">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="TextDecorations" Value="None"/>
                                                        <Setter Property="Foreground"
                                                                Value="{DynamicResource TextFillColorPrimaryBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Status}" Value="已完成">
                                                                <Setter Property="TextDecorations" Value="Strikethrough"/>
                                                                <Setter Property="Foreground"
                                                                        Value="{DynamicResource TextFillColorTertiaryBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Text="{Binding UpdatedAt, StringFormat={}{0:MM-dd HH:mm}}"
                                                       FontSize="11" Margin="12,0,0,0" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                        </StackPanel>
                                    </DockPanel>
                                    <!-- 行内子任务面板:点 ▸ 展开,可勾选/删除/直接添加 -->
                                    <StackPanel Visibility="{Binding ShowSubTasksInline, Converter={StaticResource BoolToVis}}"
                                                Margin="14,8,0,0">
                                        <ItemsControl ItemsSource="{Binding SubTasks}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <DockPanel Margin="0,2">
                                                        <ui:Button DockPanel.Dock="Right" Content="✕" Width="22" Height="22"
                                                                   Appearance="Secondary" Padding="2,0" ToolTip="删除子任务"
                                                                   Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                   Click="RemoveInlineSubTask_Click"/>
                                                        <CheckBox IsChecked="{Binding IsDone}" VerticalAlignment="Center">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="{Binding Title}" FontSize="12.5"
                                                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                                                <Border CornerRadius="7" Padding="5,0" Margin="6,0,0,0"
                                                                        VerticalAlignment="Center"
                                                                        Background="{Binding Tag, Converter={StaticResource TagBg}}">
                                                                    <Border.Style>
                                                                        <Style TargetType="Border">
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding Tag}" Value="">
                                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Border.Style>
                                                                    <TextBlock Text="{Binding Tag}" FontSize="10"
                                                                               Foreground="{Binding Tag, Converter={StaticResource TagFore}}"/>
                                                                </Border>
                                                            </StackPanel>
                                                        </CheckBox>
                                                    </DockPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <DockPanel Margin="0,4,0,0">
                                            <ui:Button DockPanel.Dock="Right" Content="添加" Width="52" Height="26"
                                                       Appearance="Primary" FontSize="11.5" Tag="{Binding}"
                                                       Click="AddInlineSubTask_Click" ToolTip="添加子任务"/>
                                            <ComboBox DockPanel.Dock="Right" Width="90" Margin="8,0,0,0"
                                                      IsEditable="true" FontSize="11"
                                                      ToolTip="新子任务的标签(可空,可自定义)"
                                                      Text="{Binding PendingSubTag, UpdateSourceTrigger=PropertyChanged}"
                                                      ItemsSource="{x:Static models:TagOptions.All}"/>
                                            <ui:TextBox PlaceholderText="添加子任务,回车" Padding="6,3"
                                                        KeyDown="InlineSubInput_KeyDown"/>
                                        </DockPanel>
                                    </StackPanel>
                                </StackPanel>
                            </ui:Card>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            <!-- 空状态提示 -->
            <TextBlock Text="🗂️ 暂无任务,上方输入标题回车添加" FontSize="13"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-60,0,0">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Items.Count}" Value="0">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Grid>
    </DockPanel>
</UserControl>
