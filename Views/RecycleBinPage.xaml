<UserControl x:Class="Workbench.Views.RecycleBinPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <DockPanel>
        <Border DockPanel.Dock="Top" Padding="0,0,0,12">
            <DockPanel>
                <ui:Button DockPanel.Dock="Right" Content="清空回收站" Appearance="Secondary"
                           Padding="12,5" Command="{Binding ClearCommand}"/>
                <TextBlock Text="删除的内容会保留在这里,随时可恢复" FontSize="12" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
            </DockPanel>
        </Border>

        <Grid>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Items}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <ui:Card Padding="12,9" Margin="0,0,0,10">
                                <DockPanel>
                                    <ui:Button DockPanel.Dock="Right" Content="✕" Width="28" Height="28"
                                               Appearance="Secondary" Padding="2,0" ToolTip="彻底删除"
                                               Command="{Binding DataContext.DeleteForeverCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                               CommandParameter="{Binding}"/>
                                    <ui:Button DockPanel.Dock="Right" Content="↩ 恢复" Appearance="Primary"
                                               Padding="12,4" Margin="0,0,8,0" ToolTip="恢复到原页面"
                                               Command="{Binding DataContext.RestoreCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                               CommandParameter="{Binding}"/>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <!-- 来源类型胶囊 -->
                                        <Border CornerRadius="10" Padding="9,2"
                                                Background="{DynamicResource ControlFillColorDefaultBrush}"
                                                BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                                                BorderThickness="1">
                                            <TextBlock FontSize="11">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="{Binding Kind}"/>
                                                        <Setter Property="Foreground"
                                                                Value="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Kind}" Value="Note">
                                                                <Setter Property="Text" Value="📝 便签"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Kind}" Value="Task">
                                                                <Setter Property="Text" Value="🗂️ 任务"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Kind}" Value="Todo">
                                                                <Setter Property="Text" Value="✅ 待办"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                        <TextBlock Text="{Binding Title}" FontSize="14" Margin="10,0,0,0"
                                                   VerticalAlignment="Center" MaxWidth="380" TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                        <TextBlock Text="{Binding DeletedAt, StringFormat={}{0:MM-dd HH:mm} 删除}"
                                                   FontSize="11" Margin="12,0,0,0" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                    </StackPanel>
                                </DockPanel>
                            </ui:Card>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            <!-- 空状态 -->
            <TextBlock Text="🗑️ 回收站是空的" FontSize="13"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-60,0,0">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Items.Count}" Value="0">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Grid>
    </DockPanel>
</UserControl>
