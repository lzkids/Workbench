<UserControl x:Class="Workbench.Views.NotesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:local="clr-namespace:Workbench.Views">

    <UserControl.Resources>
        <local:NoteColorBrushConverter x:Key="NoteBrush"/>

        <!-- 便签卡片工具按钮:浅底深棕字(卡片永远是黄底,与深浅主题无关,永远清晰) -->
        <Style x:Key="StickyToolButton" TargetType="Button">
            <Setter Property="Width" Value="22"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Background" Value="#FFFDF0"/>
            <Setter Property="Foreground" Value="#6B5E1E"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#F7E8A8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#E8D68A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Top" Padding="0,0,0,12">
            <DockPanel LastChildFill="False">
                <!-- 云同步快捷入口:不用去设置页,上传/拉取一键直达 -->
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:Button Command="{Binding Cloud.CloudPushCommand}"
                               Content="☁️ 上传"
                               IsEnabled="{Binding Cloud.CloudIdle}"
                               ToolTip="把本地数据上传到云端备份(便签/任务/待办一起)"/>
                    <ui:Button Command="{Binding Cloud.CloudSyncCommand}"
                               Content="⬇ 同步"
                               IsEnabled="{Binding Cloud.CloudIdle}"
                               Margin="8,0,0,0"
                               ToolTip="用云端数据覆盖本地(重启应用后生效;本地现状会先备份到云端 .bak)"/>
                </StackPanel>
                <ui:Button Command="{Binding NewCommand}"
                           Content="＋ 新建便签(独立置顶小窗)"
                           Appearance="Primary"
                           DockPanel.Dock="Right"/>
            </DockPanel>
        </Border>

        <Grid>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Items}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <!-- 便签卡片保持黄色纸片风格(独立于深浅主题) -->
                        <Border Width="{Binding CardWidth}" Height="{Binding CardHeight}"
                                Background="{Binding ColorKey, Converter={StaticResource NoteBrush}}"
                                BorderBrush="{Binding ColorKey, Converter={StaticResource NoteBrush}, ConverterParameter=border}"
                                BorderThickness="1" CornerRadius="8"
                                Margin="0,0,12,12" Padding="10">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="12" ShadowDepth="2" Direction="270"
                                                  Opacity="0.12" Color="#8A7B2E"/>
                            </Border.Effect>
                            <Grid>
                                <DockPanel>
                                    <DockPanel DockPanel.Dock="Top">
                                        <Button DockPanel.Dock="Right" Content="🎨" Style="{StaticResource StickyToolButton}"
                                                ToolTip="更换颜色" Click="PickColor_Click"/>
                                        <Button DockPanel.Dock="Right" Content="⤢" Style="{StaticResource StickyToolButton}"
                                                ToolTip="打开置顶小窗编辑(已打开则置前)" Click="OpenSticky_Click"/>
                                        <Button DockPanel.Dock="Right" Content="✕" Style="{StaticResource StickyToolButton}"
                                                ToolTip="删除(进回收站)"
                                                Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"/>
                                        <Button DockPanel.Dock="Right" Content="📦" Style="{StaticResource StickyToolButton}"
                                                ToolTip="归档(移到归档页)"
                                                Command="{Binding DataContext.ArchiveCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"/>
                                        <TextBlock Text="{Binding CreatedAt, StringFormat={}{0:MM-dd HH:mm}}"
                                                   FontSize="11"
                                                   Foreground="{Binding ColorKey, Converter={StaticResource NoteBrush}, ConverterParameter=accent}"
                                                   VerticalAlignment="Center"/>
                                    </DockPanel>
                                    <!-- 卡片即编辑:点击直接打字,输完即存(数据已在内存,窗口关闭/切页时落盘) -->
                                    <TextBox Text="{Binding Content, UpdateSourceTrigger=PropertyChanged}"
                                             Background="Transparent" BorderThickness="0"
                                             AcceptsReturn="True" TextWrapping="Wrap"
                                             FontSize="13"
                                             Foreground="{Binding ColorKey, Converter={StaticResource NoteBrush}, ConverterParameter=fg}"
                                             CaretBrush="{Binding ColorKey, Converter={StaticResource NoteBrush}, ConverterParameter=accent}"
                                             VerticalScrollBarVisibility="Auto" Margin="0,6,0,0"
                                             LostFocus="NoteEdit_LostFocus"/>
                                </DockPanel>
                                <!-- 右下角拖拽调整卡片大小 -->
                                <Thumb Width="12" Height="12" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                       Cursor="SizeNWSE" DragDelta="CardResize_DragDelta" ToolTip="拖拽调整大小">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Rectangle Fill="#C9B85A" Opacity="0.55"/>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Grid>
                        </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            <!-- 空状态提示 -->
            <TextBlock Text="📝 暂无便签,点击上方「新建」开始" FontSize="13"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-60,0,0">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Items.Count}" Value="0">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Grid>
    </DockPanel>
</UserControl>
