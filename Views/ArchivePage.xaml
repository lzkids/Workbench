<UserControl x:Class="Workbench.Views.ArchivePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <DockPanel>
        <Border DockPanel.Dock="Top" Padding="0,0,0,12">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <!-- 云同步快捷按钮:与便签/回收站页同一套(CloudSyncBar) -->
                    <ui:Button Command="{Binding Cloud.CloudPushCommand}"
                               Content="☁️ 上传"
                               IsEnabled="{Binding Cloud.CloudIdle}"
                               ToolTip="把本地数据上传到云端备份(便签/任务/待办一起)"/>
                    <ui:Button Command="{Binding Cloud.CloudSyncCommand}"
                               Content="⬇ 同步"
                               IsEnabled="{Binding Cloud.CloudIdle}"
                               Margin="8,0,0,0"
                               ToolTip="用云端数据覆盖本地(重启应用后生效;本地现状会先备份到云端 .bak)"/>
                </StackPanel>
                <TextBlock Text="归档的内容按类型和时间分组,点分组标题折叠/展开;恢复后回到原页面" FontSize="12"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
            </DockPanel>
        </Border>

        <Grid>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Groups}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Expander IsExpanded="{Binding IsExpanded}" Margin="0,0,0,10">
                                <Expander.Header>
                                    <TextBlock Text="{Binding Title}" FontSize="13.5" FontWeight="Bold"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                </Expander.Header>
                                <ItemsControl ItemsSource="{Binding Items}" Margin="14,6,0,6">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <ui:Card Padding="12,8" Margin="0,0,0,8">
                                                <DockPanel>
                                                    <ui:Button DockPanel.Dock="Right" Content="✕" Width="28" Height="28"
                                                               Appearance="Secondary" Padding="2,0" ToolTip="移入回收站"
                                                               Command="{Binding DataContext.RecycleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                               CommandParameter="{Binding}"/>
                                                    <ui:Button DockPanel.Dock="Right" Content="↩ 恢复" Appearance="Primary"
                                                               Padding="12,4" Margin="0,0,8,0" ToolTip="恢复到原页面"
                                                               Command="{Binding DataContext.RestoreCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                               CommandParameter="{Binding}"/>
                                                    <TextBlock Text="{Binding Title}" FontSize="14" VerticalAlignment="Center"
                                                               TextTrimming="CharacterEllipsis"
                                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                                </DockPanel>
                                            </ui:Card>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Expander>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            <!-- 空状态 -->
            <TextBlock Text="📦 归档是空的,在便签/任务/待办里点 📦 按钮即可归档" FontSize="13"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-60,0,0">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsEmpty}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Grid>
    </DockPanel>
</UserControl>
