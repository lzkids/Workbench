<UserControl x:Class="Workbench.Views.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:local="clr-namespace:Workbench.Views">

    <UserControl.Resources>
        <local:TagForeConverter x:Key="TagFore"/>
        <local:TagBgConverter x:Key="TagBg"/>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="560" HorizontalAlignment="Left">
            <!-- 通用 -->
            <TextBlock Text="通用" FontSize="15" FontWeight="Bold" Margin="0,0,0,10"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
            <ui:Card Padding="14,12" Margin="0,0,0,20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="开机自启" FontSize="14"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                        <TextBlock Text="登录 Windows 后自动打开工作台" FontSize="11.5" Margin="0,2,0,0"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                    </StackPanel>
                    <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding AutoStartEnabled}"
                                     VerticalAlignment="Center"/>
                </Grid>
            </ui:Card>

            <!-- 关闭行为 -->
            <TextBlock Text="关闭行为" FontSize="15" FontWeight="Bold" Margin="0,0,0,10"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
            <ui:Card Padding="14,12" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="点窗口右上角 ✕ 时" FontSize="11.5" Margin="0,0,0,10"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Content="每次询问" GroupName="CloseAction" Margin="0,0,20,0"
                                     IsChecked="{Binding CloseActionIsAsk}"
                                     Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                        <RadioButton Content="最小化到托盘" GroupName="CloseAction" Margin="0,0,20,0"
                                     IsChecked="{Binding CloseActionIsMinimize}"
                                     Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                     ToolTip="窗口隐藏,右下角托盘图标常驻,点它还原"/>
                        <RadioButton Content="直接退出" GroupName="CloseAction"
                                     IsChecked="{Binding CloseActionIsExit}"
                                     Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                    </StackPanel>
                </StackPanel>
            </ui:Card>

            <!-- 数据位置 -->
            <TextBlock Text="数据位置" FontSize="15" FontWeight="Bold" Margin="0,0,0,10"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
            <ui:Card Padding="14,12" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="{Binding CurrentDataDir}" FontSize="11.5" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,10"/>
                    <StackPanel Orientation="Horizontal">
                        <ui:Button Content="更改…" Appearance="Primary" Padding="14,5"
                                   Command="{Binding ChangeDataDirCommand}" Margin="0,0,8,0"
                                   ToolTip="选择新文件夹,复制数据后重启生效"/>
                        <ui:Button Content="恢复默认" Appearance="Secondary" Padding="14,5"
                                   Command="{Binding ResetDataDirCommand}"
                                   ToolTip="数据搬回程序旁 Data 文件夹"/>
                    </StackPanel>
                </StackPanel>
            </ui:Card>

            <!-- 标签管理 -->
            <TextBlock Text="标签管理" FontSize="15" FontWeight="Bold" Margin="0,0,0,10"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
            <ui:Card Padding="14,12" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="任务/子任务的标签下拉选项;删除不影响已打标签的数据" FontSize="11.5"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,0,0,10"/>
                    <DockPanel Margin="0,0,0,10">
                        <ui:Button DockPanel.Dock="Right" Content="添加" Appearance="Primary"
                                   Padding="14,5" Command="{Binding AddTagCommand}"/>
                        <ui:TextBox Text="{Binding NewTagInput, UpdateSourceTrigger=PropertyChanged}"
                                    PlaceholderText="新标签,回车添加" Padding="6,4" Margin="0,0,8,0">
                            <ui:TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding AddTagCommand}"/>
                            </ui:TextBox.InputBindings>
                        </ui:TextBox>
                    </DockPanel>
                    <ItemsControl ItemsSource="{Binding Tags}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,8,8" CornerRadius="12" Padding="10,4"
                                        Background="{Binding Path=., Converter={StaticResource TagBg}}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding}" FontSize="12"
                                                   Foreground="{Binding Path=., Converter={StaticResource TagFore}}"
                                                   VerticalAlignment="Center"/>
                                        <Button Content="✕" Margin="6,0,0,0" FontSize="10"
                                                Background="Transparent" BorderThickness="0" Cursor="Hand"
                                                Foreground="{Binding Path=., Converter={StaticResource TagFore}}"
                                                ToolTip="从下拉池里删除"
                                                Command="{Binding DataContext.RemoveTagCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ui:Card>

            <!-- 数据导出 -->
            <TextBlock Text="数据导出" FontSize="15" FontWeight="Bold" Margin="0,0,0,10"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
            <ui:Card Padding="14,12" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="把便签、任务记录、待办导出为一个文件,自动带排版样式" FontSize="11.5"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,0,0,10"/>
                    <DockPanel Margin="0,0,0,10">
                        <ui:Button DockPanel.Dock="Right" Content="更改…" Appearance="Secondary"
                                   Padding="12,4" Command="{Binding ChangeExportDirCommand}"
                                   ToolTip="选择导出的默认保存文件夹"/>
                        <TextBlock Text="{Binding CurrentExportDir}" FontSize="11.5" TextWrapping="Wrap"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    </DockPanel>
                    <StackPanel Orientation="Horizontal">
                        <ui:Button Appearance="Primary" Content="Markdown" Padding="14,5"
                                   Command="{Binding ExportMarkdownCommand}" Margin="0,0,8,0"/>
                        <ui:Button Appearance="Primary" Content="HTML" Padding="14,5"
                                   Command="{Binding ExportHtmlCommand}" Margin="0,0,8,0"/>
                        <ui:Button Appearance="Primary" Content="PDF" Padding="14,5"
                                   Command="{Binding ExportPdfCommand}"/>
                    </StackPanel>
                </StackPanel>
            </ui:Card>

            <!-- 云同步 (WebDAV) -->
            <TextBlock Text="云同步 (WebDAV)" FontSize="15" FontWeight="Bold" Margin="0,0,0,10"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
            <ui:Card Padding="14,12" Margin="0,0,0,20">
                <StackPanel>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="启用云同步" FontSize="14"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                            <TextBlock Text="只同步主数据库(便签/任务/待办);退出自动上传,启动时云端有更新自动拉取。凭据与加密口令明文存本机 Data\webdav.json——口令保护的是云端内容,不是这个文件" FontSize="11.5" Margin="0,2,0,0" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                        </StackPanel>
                        <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding CloudEnabled}"
                                         VerticalAlignment="Center"/>
                    </Grid>
                    <TextBlock Text="服务器 URL" FontSize="12" Margin="0,0,0,4"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    <ui:TextBox Text="{Binding CloudUrl, UpdateSourceTrigger=PropertyChanged}" Padding="6,4"
                                Margin="0,0,0,8"/>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="账号" FontSize="12" Margin="0,0,0,4"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            <ui:TextBox Text="{Binding CloudUsername, UpdateSourceTrigger=PropertyChanged}" Padding="6,4"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="密码(坚果云请用「应用密码」)" FontSize="12" Margin="0,0,0,4"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            <PasswordBox x:Name="CloudPasswordBox" Padding="6,4"
                                         PasswordChanged="CloudPassword_Changed"/>
                        </StackPanel>
                    </Grid>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="内容加密" FontSize="14"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                            <TextBlock Text="上传前 AES-256 加密,云端(坚果云服务器)只存密文;换电脑恢复需填同一个加密密码" FontSize="11.5" Margin="0,2,0,0"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                        </StackPanel>
                        <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding CloudEncrypt}"
                                         VerticalAlignment="Center"/>
                    </Grid>
                    <TextBlock Text="加密密码(开启内容加密后生效,务必记住——云端没有它)" FontSize="12" Margin="0,0,0,4"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    <PasswordBox x:Name="CloudCryptoBox" Padding="6,4" Margin="0,0,0,8"
                                 PasswordChanged="CloudCrypto_Changed"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <ui:Button Content="测试连接" Appearance="Secondary" Padding="14,5" Margin="0,0,8,0"
                                   Command="{Binding CloudTestCommand}" IsEnabled="{Binding CloudNotBusy}"/>
                        <ui:Button Content="立即上传" Appearance="Primary" Padding="14,5" Margin="0,0,8,0"
                                   Command="{Binding CloudPushCommand}" IsEnabled="{Binding CloudNotBusy}"
                                   ToolTip="把当前数据快照推送到云端(云端旧版本自动留 .bak)"/>
                        <ui:Button Content="从云端恢复" Appearance="Danger" Padding="14,5"
                                   Command="{Binding CloudRestoreCommand}" IsEnabled="{Binding CloudNotBusy}"
                                   ToolTip="用云端数据覆盖本地;当前本地数据会先备份到云端 .bak,重启生效"/>
                    </StackPanel>
                    <TextBlock Text="{Binding CloudStatus}" FontSize="11.5" TextWrapping="Wrap" Margin="0,0,0,4"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    <TextBlock Text="{Binding CloudLastSync, StringFormat=上次同步: {0}}" FontSize="11.5"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                </StackPanel>
            </ui:Card>

            <!-- 关于 -->
            <TextBlock Text="关于" FontSize="15" FontWeight="Bold" Margin="0,0,0,10"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
            <ui:Card Padding="14,12">
                <TextBlock Text="一款 WPF 个人效率小工具:便签 + 任务记录(含子任务/标签)+ 待办 + 活动热力图,数据 SQLite 便携存储。"
                           FontSize="12" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
            </ui:Card>
        </StackPanel>
    </ScrollViewer>
</UserControl>
