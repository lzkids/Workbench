<UserControl x:Class="Workbench.Views.DashboardPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:local="clr-namespace:Workbench.Views">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <local:InverseBoolToVisConverter x:Key="InverseBoolToVis"/>
        <local:HeatLevelConverter x:Key="HeatLevel"/>
    </UserControl.Resources>

    <DockPanel>
        <!-- 底部快速便签:粘贴/输入 → 提交 → 生成一条便签 -->
        <Border DockPanel.Dock="Bottom" Margin="0,14,0,0">
            <DockPanel>
                <ui:Button DockPanel.Dock="Right" Content="生成便签 →" Appearance="Primary"
                           Padding="14,6" Margin="10,0,0,0" Click="QuickNote_Button_Click"/>
                <ui:TextBox x:Name="QuickNoteInput" PlaceholderText="快速便签:粘贴或输入内容,回车生成(会出现在便签页)"
                            Padding="10,11" FontSize="13" MinHeight="46"
                            VerticalContentAlignment="Top" KeyDown="QuickNote_KeyDown"/>
            </DockPanel>
        </Border>

        <Grid>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="900" HorizontalAlignment="Left">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- 左:进行中的任务(点击跳转到任务页并高亮) -->
                <StackPanel Grid.Column="0">
                    <TextBlock Text="🔥 进行中的任务" FontSize="15" FontWeight="Bold" Margin="0,0,0,10"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                    <ScrollViewer MaxHeight="280" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding ActiveTasks}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <ui:Card Padding="12,9" Margin="0,0,0,8" Cursor="Hand"
                                             MouseLeftButtonDown="TaskCard_Click"
                                             ToolTip="点击跳转到任务记录">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Title}" FontSize="13.5" TextTrimming="CharacterEllipsis"
                                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                <TextBlock Text="{Binding Status}" FontSize="11"
                                                           Foreground="#D97706"/>
                                                <TextBlock Text="{Binding SubTasksProgress}" FontSize="11" Margin="10,0,0,0"
                                                           Visibility="{Binding HasSubTasks, Converter={StaticResource BoolToVis}}"
                                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </ui:Card>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <TextBlock Text="没有进行中的任务,去任务页看看" FontSize="12" Margin="0,8,0,0"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                               Visibility="{Binding AnyTasks, Converter={StaticResource InverseBoolToVis}}"/>
                </StackPanel>

                <!-- 右:未完成待办(勾选完成 = 自动归档) -->
                <StackPanel Grid.Column="2">
                    <TextBlock Text="✅ 待办" FontSize="15" FontWeight="Bold" Margin="0,0,0,10"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                    <ScrollViewer MaxHeight="280" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding PendingTodos}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <ui:Card Padding="12,8" Margin="0,0,0,8">
                                        <DockPanel>
                                            <CheckBox IsChecked="{Binding IsDone}" Checked="QuickDone_Changed"
                                                      VerticalAlignment="Center">
                                            <CheckBox.Content>
                                                <TextBlock Text="{Binding Title}" FontSize="13.5">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground"
                                                                    Value="{DynamicResource TextFillColorPrimaryBrush}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsDone}" Value="True">
                                                                    <Setter Property="TextDecorations" Value="Strikethrough"/>
                                                                    <Setter Property="Foreground"
                                                                            Value="{DynamicResource TextFillColorTertiaryBrush}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </CheckBox.Content>
                                        </CheckBox>
                                        <TextBlock DockPanel.Dock="Right" Text="⏰" FontSize="11" VerticalAlignment="Center"
                                                   Foreground="#DC2626" ToolTip="已逾期"
                                                   Visibility="{Binding IsOverdue, Converter={StaticResource BoolToVis}}"/>
                                    </DockPanel>
                                </ui:Card>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    </ScrollViewer>
                    <TextBlock Text="全部完成,轻松的一天 🎉" FontSize="12" Margin="0,4,0,0"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                               Visibility="{Binding AnyTodos, Converter={StaticResource InverseBoolToVis}}"/>
                </StackPanel>
            </Grid>

            <!-- 活动热力图(GitHub 风格):近 26 周,每天完成/新建 1 项记 1 格 -->
            <StackPanel Margin="0,24,0,0">
                <TextBlock FontSize="15" FontWeight="Bold" Margin="0,0,0,8"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}">
                    <Run Text="🔥 活动热力图"/>
                    <Run Text="{Binding HeatTotal, Mode=OneWay, StringFormat=· 近 26 周 {0} 项活动}"
                         FontSize="11" FontWeight="Normal"
                         Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                </TextBlock>
                <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="12">
                    <StackPanel>
                        <ItemsControl ItemsSource="{Binding HeatWeeks}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <ItemsControl ItemsSource="{Binding Days}" Margin="1">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel VerticalAlignment="Top"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Rectangle Width="11" Height="11" Margin="1" RadiusX="2" RadiusY="2"
                                                           Fill="{Binding Level, Converter={StaticResource HeatLevel}}"
                                                           ToolTip="{Binding Tip}"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                            <TextBlock Text="少" FontSize="10.5" VerticalAlignment="Center" Margin="0,0,6,0"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                            <Rectangle Width="10" Height="10" Margin="1" RadiusX="2" RadiusY="2" Fill="#E8E8E8"/>
                            <Rectangle Width="10" Height="10" Margin="1" RadiusX="2" RadiusY="2" Fill="#9BE9A8"/>
                            <Rectangle Width="10" Height="10" Margin="1" RadiusX="2" RadiusY="2" Fill="#40C463"/>
                            <Rectangle Width="10" Height="10" Margin="1" RadiusX="2" RadiusY="2" Fill="#2DA44E"/>
                            <Rectangle Width="10" Height="10" Margin="1" RadiusX="2" RadiusY="2" Fill="#216E39"/>
                            <TextBlock Text="多" FontSize="10.5" VerticalAlignment="Center" Margin="6,0,0,0"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>

    </DockPanel>
</UserControl>
