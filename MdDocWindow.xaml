<ui:FluentWindow x:Class="Workbench.MdDocWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Markdown" Width="860" Height="560" MinWidth="520" MinHeight="320"
        WindowStartupLocation="CenterScreen"
        ExtendsContentIntoTitleBar="True"
        Closed="Window_Closed">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <ui:TitleBar x:Name="TitleBar" Title="Markdown"/>
        <Grid Grid.Row="1" Margin="10,0,10,10">
            <Grid.ColumnDefinitions>
                <!-- 文件树侧栏:全部 MD 文档,点击原地切换;28px 常驻窄条放展开开关 -->
                <ColumnDefinition x:Name="SidebarCol" Width="200"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 侧栏:展开态=文档列表 -->
            <Border x:Name="Sidebar" Grid.Column="0"
                    Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}"
                    BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                    BorderThickness="0,0,1,0" CornerRadius="8,0,0,8" Margin="0,0,0,0">
                <DockPanel>
                    <Button DockPanel.Dock="Top" Content="« 收起" Click="ToggleSidebar_Click"
                            Background="Transparent" BorderThickness="0" Cursor="Hand"
                            HorizontalAlignment="Right" Margin="0,2,4,4"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    <Button DockPanel.Dock="Top" Content="＋ 新建文档" Click="NewDoc_Click"
                            Margin="6,0,6,6" Padding="8,5" Cursor="Hand"
                            HorizontalAlignment="Stretch"/>
                    <TextBlock DockPanel.Dock="Top" Text="📄 全部文档" FontSize="12" Margin="8,0,0,4"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                    <ListBox x:Name="DocList"
                             DisplayMemberPath="Title"
                             Background="Transparent" BorderThickness="0"
                             SelectionChanged="DocList_SelectionChanged"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
                </DockPanel>
            </Border>

            <!-- 侧栏:收起态=窄条展开按钮 -->
            <Border x:Name="SidebarRail" Grid.Column="0" Width="0" Visibility="Collapsed"
                    Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}"
                    BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                    BorderThickness="0,0,1,0" CornerRadius="8,0,0,8">
                <Button Content="»" Click="ToggleSidebar_Click"
                        Background="Transparent" BorderThickness="0" Cursor="Hand"
                        VerticalAlignment="Top" Margin="0,8,0,0"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
            </Border>

            <Grid Grid.Column="1" Margin="8,0,0,0">
                <!-- 编辑区卡片:浅色下白底白窗看不出边界,用次级底色+分隔线描边做出明确的内容区卡片 -->
                <Border Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}"
                        BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="8">
                    <!-- 编辑器从一开始就可见:WebView2 hwnd 必须以真实尺寸创建(Collapsed/Hidden 下 0 尺寸初始化会视口错配);
                         FallbackBox 铺同格被 hwnd 盖住,失败/看门狗时撤 Editor 翻出回退框 -->
                    <wv2:WebView2 x:Name="Editor"/>
                </Border>
                <TextBox x:Name="FallbackBox" Text="{Binding Content, UpdateSourceTrigger=PropertyChanged}"
                         AcceptsReturn="True" TextWrapping="Wrap"
                         Background="Transparent" BorderThickness="0"
                         FontSize="14"
                         Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                         Visibility="Collapsed"
                         VerticalScrollBarVisibility="Auto"/>
            </Grid>
        </Grid>
    </Grid>
</ui:FluentWindow>
