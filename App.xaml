<Application x:Class="Workbench.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- WPF UI:Win11 Fluent 主题,深浅色可运行时切换 -->
                <ui:ThemesDictionary Theme="Light"/>
                <ui:ControlsDictionary/>
            </ResourceDictionary.MergedDictionaries>

            <!-- 用户偏好:所有输入框方角(覆盖 WPF UI 的圆角资源,双键保险) -->
            <CornerRadius x:Key="ControlCornerRadius">0,0,0,0</CornerRadius>
            <CornerRadius x:Key="TextBoxControlCornerRadius">0,0,0,0</CornerRadius>
        </ResourceDictionary>
    </Application.Resources>
</Application>
