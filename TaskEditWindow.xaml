<ui:FluentWindow x:Class="Workbench.TaskEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="编辑任务" Width="460" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ExtendsContentIntoTitleBar="True">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="编辑任务" Icon="/Assets/app.ico"/>

        <StackPanel Grid.Row="1" Margin="20,8,20,20">
            <TextBlock Text="标题" FontSize="12"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
            <ui:TextBox Text="{Binding Task.Title, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,12"/>

            <TextBlock Text="详情" FontSize="12"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
            <ui:TextBox Text="{Binding Task.Content, UpdateSourceTrigger=PropertyChanged}"
                        AcceptsReturn="True" TextWrapping="Wrap" Height="120"
                        Margin="0,4,0,12" VerticalContentAlignment="Top"
                        VerticalScrollBarVisibility="Auto"/>

            <TextBlock Text="状态" FontSize="12"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
            <ComboBox ItemsSource="{Binding Statuses}" SelectedItem="{Binding Task.Status}"
                      Width="140" HorizontalAlignment="Left" Margin="0,4,0,12"/>

            <TextBlock Text="标签" FontSize="12"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
            <ComboBox IsEditable="true" Width="140" HorizontalAlignment="Left" Margin="0,4,0,16"
                      ToolTip="可从预设里选,也可以自由输入"
                      Text="{Binding Task.Tag, UpdateSourceTrigger=PropertyChanged}"
                      ItemsSource="{Binding TagOptions}"/>

            <!-- 子任务区 -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="子任务" FontSize="12"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                <TextBlock Grid.Column="1" Text="{Binding Task.SubTasksProgress}" FontSize="12"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
            </Grid>
            <ItemsControl ItemsSource="{Binding Task.SubTasks}" Margin="0,6,0,6">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <DockPanel Margin="0,2">
                            <ui:Button DockPanel.Dock="Right" Content="✕" Width="24" Height="24"
                                       Appearance="Secondary" Padding="2,0" ToolTip="删除子任务"
                                       Click="RemoveSubTask_Click"/>
                            <ComboBox DockPanel.Dock="Right" IsEditable="true" Width="84" Margin="8,0,0,0"
                                      FontSize="11" ToolTip="子任务标签(可自定义)"
                                      Text="{Binding Tag, UpdateSourceTrigger=PropertyChanged}"
                                      ItemsSource="{Binding DataContext.TagOptions, RelativeSource={RelativeSource AncestorType=ui:FluentWindow}}"/>
                            <CheckBox IsChecked="{Binding IsDone}" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Title}" FontSize="13"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                            </CheckBox>
                        </DockPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <DockPanel Margin="0,0,0,16">
                <ui:Button DockPanel.Dock="Right" Content="＋ 添加" Appearance="Secondary"
                           Padding="12,4" Margin="8,0,0,0" Click="AddSubTask_Click"/>
                <ComboBox DockPanel.Dock="Right" IsEditable="true" Width="100" FontSize="11"
                          VerticalAlignment="Center" ToolTip="新子任务的标签(可空,可自定义)"
                          Text="{Binding Task.PendingSubTag, UpdateSourceTrigger=PropertyChanged}"
                          ItemsSource="{Binding TagOptions}"/>
                <ui:TextBox x:Name="SubTaskInput" PlaceholderText="输入子任务,回车添加" Padding="6,4"
                            KeyDown="SubTaskInput_KeyDown"/>
            </DockPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <ui:Button Content="保存" Click="Save_Click" Appearance="Primary"
                           Padding="22,5" Margin="0,0,8,0"/>
                <ui:Button Content="取消" IsCancel="True" Appearance="Secondary" Padding="22,5"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</ui:FluentWindow>
