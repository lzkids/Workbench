<ui:FluentWindow x:Class="Workbench.QuickTodoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="快速待办" Width="380" Height="230"
        MinWidth="380" MaxWidth="480" MinHeight="230"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        ExtendsContentIntoTitleBar="True">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="快速待办" Icon="/Assets/app.ico"/>

        <Grid Grid.Row="1" Margin="20,6,20,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <ui:TextBox Grid.Row="0" x:Name="TitleInput" PlaceholderText="待办内容,回车添加"
                        Margin="0,0,0,12" KeyDown="TitleInput_KeyDown"/>

            <Grid Grid.Row="1" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="优先级" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="12.5"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                <ComboBox Grid.Column="1" x:Name="PriorityBox" SelectedIndex="1" Width="80"
                          VerticalAlignment="Center">
                    <ComboBoxItem Content="高"/>
                    <ComboBoxItem Content="普通"/>
                    <ComboBoxItem Content="低"/>
                </ComboBox>
                <TextBlock Grid.Column="2" Text="到期" VerticalAlignment="Center" Margin="16,0,8,0" FontSize="12.5"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                <DatePicker Grid.Column="3" x:Name="DueBox" Width="130" VerticalAlignment="Center"/>
            </Grid>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                <ui:Button Content="添加" Appearance="Primary" Padding="24,5" Click="Add_Click" IsDefault="True"/>
                <ui:Button Content="取消" Appearance="Secondary" Padding="24,5" Margin="8,0,0,0" IsCancel="True"/>
            </StackPanel>
        </Grid>
    </Grid>
</ui:FluentWindow>
