<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
    像素风皮肤(复古绿/GameBoy 掌机气质):覆写 WPF-UI 主题笔刷键为复古绿调色板。
    由 App.ApplyTheme("Pixel") 以暗色打底后合并进应用资源(最后合并的字典查找优先),
    DynamicResource 引用会实时刷新;切回亮/暗时整个字典被移除恢复原样。
    键名为超集策略:应用/模板没用到多余键亦无害;圆角与字体由 ApplyTheme 直接改
    App 主资源(CardCornerRadius 等 + AppFontFamily),不在此字典内(主字典优先级更高)。
    -->
    <SolidColorBrush x:Key="ApplicationBackgroundBrush" Color="#141812"/>
    <SolidColorBrush x:Key="ApplicationBackgroundColorBrush" Color="#141812"/>

    <!-- 主背景层 -->
    <SolidColorBrush x:Key="SolidBackgroundFillColorBaseBrush" Color="#141812"/>
    <SolidColorBrush x:Key="SolidBackgroundFillColorBaseAltBrush" Color="#181C15"/>
    <SolidColorBrush x:Key="SolidBackgroundFillColorBaseBrushPointerOver" Color="#181C15"/>
    <SolidColorBrush x:Key="SolidBackgroundFillColorBaseAltBrushPointerOver" Color="#1C2117"/>
    <SolidColorBrush x:Key="SolidBackgroundFillColorSecondaryBrush" Color="#1F2618"/>
    <SolidColorBrush x:Key="SolidBackgroundFillColorTertiaryBrush" Color="#252D1C"/>

    <!-- 控件层 -->
    <SolidColorBrush x:Key="ControlFillColorDefaultBrush" Color="#252D1C"/>
    <SolidColorBrush x:Key="ControlFillColorSecondaryBrush" Color="#1F2618"/>
    <SolidColorBrush x:Key="ControlFillColorTertiaryBrush" Color="#2B3320"/>
    <SolidColorBrush x:Key="ControlFillColorDisabledBrush" Color="#22291A"/>
    <SolidColorBrush x:Key="ControlFillColorDefaultBrushPointerOver" Color="#2B3320"/>
    <SolidColorBrush x:Key="ControlFillColorSecondaryBrushPointerOver" Color="#2B3320"/>
    <SolidColorBrush x:Key="ControlFillColorTertiaryBrushPointerOver" Color="#313A24"/>
    <SolidColorBrush x:Key="ControlFillColorDefaultBrushPressed" Color="#313A24"/>
    <SolidColorBrush x:Key="ControlFillColorSecondaryBrushPressed" Color="#313A24"/>
    <SolidColorBrush x:Key="ControlFillColorTertiaryBrushPressed" Color="#3A4429"/>

    <!-- 悬停层:半透明(叠层刷子,灵动岛 HoverBd 等直接叠在图标上层——不透明会遮住内容) -->
    <SolidColorBrush x:Key="SubtleFillColorSecondaryBrush" Color="#2EC6D9A3"/>
    <SolidColorBrush x:Key="SubtleFillColorTertiaryBrush" Color="#44C6D9A3"/>
    <SolidColorBrush x:Key="SubtleFillColorSecondaryBrushPointerOver" Color="#38C6D9A3"/>
    <SolidColorBrush x:Key="SubtleFillColorTertiaryBrushPointerOver" Color="#4DC6D9A3"/>

    <!-- 卡片 -->
    <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="#1F2618"/>
    <SolidColorBrush x:Key="CardBackgroundFillColorSecondaryBrush" Color="#1B2115"/>

    <!-- 文字 -->
    <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#C6D9A3"/>
    <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#8FA06F"/>
    <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="#62724A"/>
    <SolidColorBrush x:Key="TextFillColorDisabledBrush" Color="#4A5638"/>
    <SolidColorBrush x:Key="TextFillColorInverseBrush" Color="#141812"/>

    <!-- 分隔线/描边 -->
    <SolidColorBrush x:Key="DividerStrokeColorDefaultBrush" Color="#3A4429"/>

    <!-- 强调色(复古荧光绿) -->
    <Color x:Key="SystemAccentColor">#7FC65B</Color>
    <Color x:Key="SystemAccentColorDark1">#6FB24E</Color>
    <Color x:Key="SystemAccentColorLight1">#8FD46A</Color>
    <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#7FC65B"/>
    <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#6FB24E"/>
    <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#5E9440"/>
    <SolidColorBrush x:Key="AccentFillColorDisabledBrush" Color="#43552F"/>
    <SolidColorBrush x:Key="AccentFillColorDefaultBrushPointerOver" Color="#8FD46A"/>
    <SolidColorBrush x:Key="AccentFillColorDefaultBrushPressed" Color="#6FB24E"/>
    <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#A5E17E"/>
    <SolidColorBrush x:Key="AccentTextFillColorSecondaryBrush" Color="#8FD46A"/>
    <SolidColorBrush x:Key="AccentTextFillColorTertiaryBrush" Color="#6FB24E"/>
    <SolidColorBrush x:Key="SystemFillColorAccentBrush" Color="#7FC65B"/>

    <!-- 复古绿下语义色微调(成功/警告红绿融进调色板,红色保留辨识度) -->
    <SolidColorBrush x:Key="SystemFillColorSuccessBrush" Color="#7FC65B"/>
    <SolidColorBrush x:Key="SystemFillColorCriticalBrush" Color="#E0705A"/>
    <SolidColorBrush x:Key="SystemFillColorCautionBrush" Color="#D9B24C"/>
</ResourceDictionary>
