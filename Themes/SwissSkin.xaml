<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
    瑞士现代主义 2.0 皮肤(Swiss Modernism):白底黑字 + 单一强调红 #FF2D20 + 灰描边 #DCDCDC,
    扁平无装饰、高对比、栅格感(参考 dsh-ui-ux-pro-max gallery/swiss-modernism-2-0 规格)。
    由 App.ApplyTheme("Swiss") 以亮色打底后合并进应用资源;切回其它主题时整个字典被移除。
    圆角与字体由 ApplyTheme 直接改 App 主资源(瑞士=直角 + 系统字体)。
    悬停层刷子必须半透明(叠层用法,灵动岛 HoverBd 直接叠在图标上层)。
    -->
    <SolidColorBrush x:Key="ApplicationBackgroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="ApplicationBackgroundColorBrush" Color="#FFFFFF"/>

    <!-- 主背景层 -->
    <SolidColorBrush x:Key="SolidBackgroundFillColorBaseBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SolidBackgroundFillColorBaseAltBrush" Color="#F5F5F5"/>
    <SolidColorBrush x:Key="SolidBackgroundFillColorBaseBrushPointerOver" Color="#F5F5F5"/>
    <SolidColorBrush x:Key="SolidBackgroundFillColorBaseAltBrushPointerOver" Color="#EFEFEF"/>
    <SolidColorBrush x:Key="SolidBackgroundFillColorSecondaryBrush" Color="#F5F5F5"/>
    <SolidColorBrush x:Key="SolidBackgroundFillColorTertiaryBrush" Color="#EDEDED"/>

    <!-- 控件层 -->
    <SolidColorBrush x:Key="ControlFillColorDefaultBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="ControlFillColorSecondaryBrush" Color="#F5F5F5"/>
    <SolidColorBrush x:Key="ControlFillColorTertiaryBrush" Color="#EAEAEA"/>
    <SolidColorBrush x:Key="ControlFillColorDisabledBrush" Color="#F2F2F2"/>
    <SolidColorBrush x:Key="ControlFillColorDefaultBrushPointerOver" Color="#FAFAFA"/>
    <SolidColorBrush x:Key="ControlFillColorSecondaryBrushPointerOver" Color="#EFEFEF"/>
    <SolidColorBrush x:Key="ControlFillColorTertiaryBrushPointerOver" Color="#E0E0E0"/>
    <SolidColorBrush x:Key="ControlFillColorDefaultBrushPressed" Color="#E5E5E5"/>
    <SolidColorBrush x:Key="ControlFillColorSecondaryBrushPressed" Color="#E5E5E5"/>
    <SolidColorBrush x:Key="ControlFillColorTertiaryBrushPressed" Color="#D9D9D9"/>

    <!-- 悬停层(半透明黑,叠层刷子) -->
    <SolidColorBrush x:Key="SubtleFillColorSecondaryBrush" Color="#0F000000"/>
    <SolidColorBrush x:Key="SubtleFillColorTertiaryBrush" Color="#1A000000"/>
    <SolidColorBrush x:Key="SubtleFillColorSecondaryBrushPointerOver" Color="#14000000"/>
    <SolidColorBrush x:Key="SubtleFillColorTertiaryBrushPointerOver" Color="#1F000000"/>

    <!-- 卡片 -->
    <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="CardBackgroundFillColorSecondaryBrush" Color="#F7F7F7"/>

    <!-- 文字(纯黑主文字,高对比) -->
    <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#000000"/>
    <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#3D3D3D"/>
    <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="#767676"/>
    <SolidColorBrush x:Key="TextFillColorDisabledBrush" Color="#B0B0B0"/>
    <SolidColorBrush x:Key="TextFillColorInverseBrush" Color="#FFFFFF"/>

    <!-- 描边(Swiss 银灰令牌) -->
    <SolidColorBrush x:Key="DividerStrokeColorDefaultBrush" Color="#DCDCDC"/>

    <!-- 强调色(唯一强调红) -->
    <Color x:Key="SystemAccentColor">#FF2D20</Color>
    <Color x:Key="SystemAccentColorDark1">#E0251C</Color>
    <Color x:Key="SystemAccentColorLight1">#FF4D3E</Color>
    <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#FF2D20"/>
    <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#E0251C"/>
    <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#C21F17"/>
    <SolidColorBrush x:Key="AccentFillColorDisabledBrush" Color="#F2B0AA"/>
    <SolidColorBrush x:Key="AccentFillColorDefaultBrushPointerOver" Color="#E0251C"/>
    <SolidColorBrush x:Key="AccentFillColorDefaultBrushPressed" Color="#C21F17"/>
    <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#D9271C"/>
    <SolidColorBrush x:Key="AccentTextFillColorSecondaryBrush" Color="#E0251C"/>
    <SolidColorBrush x:Key="AccentTextFillColorTertiaryBrush" Color="#C21F17"/>
    <SolidColorBrush x:Key="SystemFillColorAccentBrush" Color="#FF2D20"/>

    <!-- 语义色(瑞士式克制,不抢红强调) -->
    <SolidColorBrush x:Key="SystemFillColorSuccessBrush" Color="#15803D"/>
    <SolidColorBrush x:Key="SystemFillColorCriticalBrush" Color="#DC2626"/>
    <SolidColorBrush x:Key="SystemFillColorCautionBrush" Color="#D97706"/>
</ResourceDictionary>
