<ui:FluentWindow x:Class="Workbench.CloseAskWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="关闭工作台" Width="420" Height="220"
        MinWidth="420" MaxWidth="480" MinHeight="220"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        ExtendsContentIntoTitleBar="True">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="关闭工作台" Icon="/Assets/app.ico"/>

        <Grid Grid.Row="1" Margin="20,6,20,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" LastChildFill="True" Margin="0,0,0,14">
                <TextBlock DockPanel.Dock="Left" Text="🌙" FontSize="24"
                           Margin="0,0,12,0" VerticalAlignment="Top"/>
                <TextBlock Text="最小化到系统托盘（右下角）还是直接退出？"
                           TextWrapping="Wrap" FontSize="13.5" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
            </DockPanel>

            <CheckBox Grid.Row="1" x:Name="RememberBox" Content="记住我的选择（可在设置页更改）"
                      IsChecked="True" Margin="2,0,0,16"
                      Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                <ui:Button Content="最小化到托盘" Appearance="Primary"
                           Padding="20,5" Margin="0,0,8,0" Click="Minimize_Click"/>
                <ui:Button Content="直接退出" Appearance="Secondary"
                           Padding="20,5" Click="Exit_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</ui:FluentWindow>
