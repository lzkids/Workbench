<ui:FluentWindow x:Class="Workbench.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Workbench.ViewModels"
        xmlns:views="clr-namespace:Workbench.Views"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="工作台" Height="600" Width="920" MinHeight="480" MinWidth="720"
        WindowStartupLocation="CenterScreen"
        ExtendsContentIntoTitleBar="True">

    <!-- 核心:内容区绑定的是 ViewModel,这里按 ViewModel 类型映射到对应页面(UserControl) -->
    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <views:DashboardPage/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:NotesViewModel}">
            <views:NotesPage/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:TasksViewModel}">
            <views:TasksPage/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:TodosViewModel}">
            <views:TodosPage/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ArchiveViewModel}">
            <views:ArchivePage/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:RecycleBinViewModel}">
            <views:RecycleBinPage/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsPage/>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Win11 风标题栏:融入窗口,自动深浅色(应用名在侧栏已有,这里只留图标防重复) -->
        <ui:TitleBar Grid.Row="0" Icon="/Assets/app.ico"/>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧导航:圆角高亮 + 底部主题切换 -->
            <Border Grid.Column="0"
                    BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                    BorderThickness="0,0,1,0">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="22,10,0,12">
                        <TextBlock Text="工作台" FontSize="17" FontWeight="Bold"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                        <TextBlock Text="Workbench" FontSize="10" Margin="0,2,0,0"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                    </StackPanel>

                    <ui:Button x:Name="ThemeToggle" DockPanel.Dock="Bottom"
                               Click="ThemeToggle_Click"
                               Content="🌙 深色模式" Appearance="Secondary"
                               HorizontalAlignment="Stretch" Margin="12,8,12,12"/>

                    <ListBox ItemsSource="{Binding NavItems}"
                             SelectedItem="{Binding Selected}"
                             BorderThickness="0" Background="Transparent" Padding="0,2">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Bd" CornerRadius="8" Margin="12,3" Padding="12,9"
                                                    Background="Transparent" SnapsToDevicePixels="True">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background"
                                                            Value="{DynamicResource SubtleFillColorSecondaryBrush}"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="#2563EB"/>
                                                    <Setter Property="Foreground" Value="White"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <!-- Glyph 是彩色 emoji,不吃 Foreground;Title 是文字,必须显式跟主题,
                                         否则深色下是原生黑字=隐形(选中态由 DataTrigger 覆盖为白色) -->
                                    <TextBlock Text="{Binding Glyph}" FontSize="15" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding Title}" FontSize="13.5" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground"
                                                        Value="{DynamicResource TextFillColorPrimaryBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                        <Setter Property="Foreground" Value="White"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- 右侧内容区 -->
            <ContentControl Grid.Column="1" Content="{Binding Current}" Margin="22,16"/>
        </Grid>
    </Grid>
</ui:FluentWindow>
